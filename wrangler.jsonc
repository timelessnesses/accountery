/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "accounting",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-06-21",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_als"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"upload_source_maps": true,
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "AccountingDatabase",
			"database_name": "accountingdb",
			"database_id": "a91aeecd-0238-40c9-8506-0382f0ec850f",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "accounting-receipts",
			"binding": "AccountingReceipts"
		}
	],
	"secrets_store_secrets": [
		{
			"binding": "SharedSecrets",
			"store_id": "28edd17fa16c4dc4ad491c8e0a95d7b0",
			"secret_name": "ACCOUNTERY_JWT_SECRET"
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "notification",
				"dead_letter_queue": "notification-dead-letter",
				"max_batch_size": 10,
				"max_retries": 3
			}
		],
		"producers": [
			{
				"queue": "notification",
				"binding": "NotificationQueue"
			}
		]
	},
	"images": {
		"binding": "CloudflareImageManipulator5000"
	},

	"observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
	},
	"kv_namespaces": [
		{
			"binding": "AccounteryCaching",
			"id": "e6f5424583d74d0c852a01a82392c537"
	}
	]
	/* 
	"durable_objects": {
		"bindings": [
			{
				"name": "DurableDatabase",
				"class_name": "DODatabase",
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DODatabase"
			]
		}
	] */
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}